{
  "name": "05 - LifeSync Slack Monitor",
  "nodes": [
    {
      "parameters": {
        "event": "message",
        "channelId": ["YOUR_SLACK_CHANNEL_IDS"],
        "options": {}
      },
      "id": "slack-trigger",
      "name": "Slack Trigger",
      "type": "n8n-nodes-base.slackTrigger",
      "typeVersion": 1,
      "position": [220, 300],
      "credentials": {
        "slackOAuth2Api": {
          "id": "SLACK_CREDENTIAL_ID",
          "name": "Slack Account"
        }
      },
      "notes": "SETUP: Connect Slack OAuth2 credentials and select the channels you want to monitor (including DM channels with MVPs)."
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.event.bot_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "empty" }
            }
          ]
        }
      },
      "id": "filter-bots",
      "name": "Skip Bot Messages",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "jsCode": "const msg = $input.item.json;\nconst text = msg.event?.text || msg.text || '';\nconst user = msg.event?.user || 'Unknown';\nconst channel = msg.event?.channel || '';\nconst ts = msg.event?.ts || '';\nconst threadTs = msg.event?.thread_ts || ts;\n\nreturn [{\n  json: {\n    text,\n    user,\n    channel,\n    timestamp: ts,\n    threadTs,\n    promptText: `Slack message from user ${user} in channel ${channel}:\\n\\n${text}`\n  }\n}];"
      },
      "id": "extract-message",
      "name": "Extract Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $credentials.httpHeaderAuth.value }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5-20241022\",\n  \"max_tokens\": 256,\n  \"system\": \"You are filtering Slack messages for a busy parent. Determine if this message is relevant to family scheduling, kid activities, school events, or anything a parent would want to know about outside of work. Respond with ONLY a JSON object: {\\\"relevant\\\": true/false, \\\"summary\\\": \\\"one sentence summary if relevant\\\", \\\"category\\\": \\\"work|family|school|social|irrelevant\\\"}\",\n  \"messages\": [{\"role\": \"user\", \"content\": {{ JSON.stringify($json.promptText) }}}]\n}",
        "options": {}
      },
      "id": "claude-filter",
      "name": "Claude Filter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ANTHROPIC_CREDENTIAL_ID",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.item.json;\nconst msgData = $('Extract Message').item.json;\nlet parsed;\n\ntry {\n  parsed = JSON.parse(response.content[0].text);\n} catch (e) {\n  const match = response.content[0].text.match(/\\{[\\s\\S]*\\}/);\n  parsed = match ? JSON.parse(match[0]) : { relevant: false };\n}\n\nreturn [{\n  json: {\n    ...msgData,\n    ...parsed\n  }\n}];"
      },
      "id": "parse-filter",
      "name": "Parse Filter Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 200]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.relevant }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      },
      "id": "is-relevant",
      "name": "Is Relevant?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, 200]
    },
    {
      "parameters": {
        "from": "YOUR_TWILIO_PHONE_NUMBER",
        "to": "YOUR_PHONE_NUMBER",
        "message": "=Slack Update: {{ $json.summary }}"
      },
      "id": "send-sms",
      "name": "Send SMS via Twilio",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [1540, 100],
      "credentials": {
        "twilioApi": {
          "id": "TWILIO_CREDENTIAL_ID",
          "name": "Twilio"
        }
      },
      "notes": "SETUP: Replace YOUR_TWILIO_PHONE_NUMBER and YOUR_PHONE_NUMBER"
    },
    {
      "parameters": {
        "jsCode": "// ======================================================\n// MVP LIST — Add your VIP Slack user IDs here\n// To find a user's Slack ID: click their profile > \"...\" > \"Copy member ID\"\n// ======================================================\nconst MVP_USER_IDS = [\n  // 'U01ABC123',  // e.g. Your boss\n  // 'U02DEF456',  // e.g. Key stakeholder\n  // 'U03GHI789',  // e.g. Important client contact\n];\n\nconst YOUR_SLACK_USER_ID = 'YOUR_SLACK_USER_ID'; // SETUP: Your own Slack user ID\n\nconst msg = $input.item.json;\nconst senderUserId = msg.user;\n\n// Only flag if sender is an MVP and sender is NOT you\nconst isMvp = MVP_USER_IDS.includes(senderUserId) && senderUserId !== YOUR_SLACK_USER_ID;\n\nreturn [{\n  json: {\n    ...msg,\n    isMvp,\n    senderUserId,\n    yourUserId: YOUR_SLACK_USER_ID\n  }\n}];",
        "notices": "SETUP: Add your MVP Slack user IDs to the MVP_USER_IDS array and set YOUR_SLACK_USER_ID"
      },
      "id": "check-mvp",
      "name": "Is MVP Sender?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 500]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.isMvp }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      },
      "id": "mvp-gate",
      "name": "MVP?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 500]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "minutes"
      },
      "id": "wait-5min",
      "name": "Wait 5 Minutes",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1320, 500],
      "webhookId": "mvp-wait-timer"
    },
    {
      "parameters": {
        "url": "=https://slack.com/api/conversations.replies",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $credentials.httpHeaderAuth.value }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "channel", "value": "={{ $('Is MVP Sender?').item.json.channel }}" },
            { "name": "ts", "value": "={{ $('Is MVP Sender?').item.json.threadTs }}" },
            { "name": "oldest", "value": "={{ $('Is MVP Sender?').item.json.timestamp }}" },
            { "name": "limit", "value": "50" }
          ]
        },
        "options": {}
      },
      "id": "check-replies",
      "name": "Check Thread Replies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 500],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SLACK_BOT_TOKEN_CREDENTIAL_ID",
          "name": "Slack Bot Token"
        }
      },
      "notes": "SETUP: Create an HTTP Header Auth credential with Name='Authorization' and Value='Bearer xoxb-YOUR-SLACK-BOT-TOKEN'. Or reuse your Slack OAuth token."
    },
    {
      "parameters": {
        "jsCode": "const replies = $input.item.json;\nconst mvpData = $('Is MVP Sender?').item.json;\nconst yourUserId = mvpData.yourUserId;\nconst originalTs = mvpData.timestamp;\n\n// Check if any reply in the thread is from you, after the original message\nlet youReplied = false;\n\nif (replies.ok && replies.messages) {\n  youReplied = replies.messages.some(msg => {\n    return msg.user === yourUserId && msg.ts > originalTs;\n  });\n}\n\n// Also check the channel for direct messages from you after the MVP's message\n// (covers cases where the reply isn't threaded)\nreturn [{\n  json: {\n    ...mvpData,\n    youReplied,\n    replyCount: replies.messages?.length || 0\n  }\n}];"
      },
      "id": "parse-replies",
      "name": "Did You Reply?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 500]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.youReplied }}",
              "rightValue": false,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      },
      "id": "no-reply-gate",
      "name": "No Reply?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1980, 500]
    },
    {
      "parameters": {
        "url": "=https://slack.com/api/users.info",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $credentials.httpHeaderAuth.value }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "user", "value": "={{ $json.senderUserId }}" }
          ]
        },
        "options": {}
      },
      "id": "get-mvp-name",
      "name": "Get MVP Name",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SLACK_BOT_TOKEN_CREDENTIAL_ID",
          "name": "Slack Bot Token"
        }
      }
    },
    {
      "parameters": {
        "from": "YOUR_TWILIO_PHONE_NUMBER",
        "to": "YOUR_PHONE_NUMBER",
        "message": "=⚡ MVP ALERT: {{ $json.user?.real_name || $json.user?.name || 'Someone important' }} messaged you 5 min ago and you haven't replied.\n\nMessage: {{ $('Is MVP Sender?').item.json.text }}"
      },
      "id": "send-mvp-alert",
      "name": "Send MVP Alert SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [2420, 400],
      "credentials": {
        "twilioApi": {
          "id": "TWILIO_CREDENTIAL_ID",
          "name": "Twilio"
        }
      },
      "notes": "SETUP: Replace YOUR_TWILIO_PHONE_NUMBER and YOUR_PHONE_NUMBER"
    },
    {
      "parameters": {
        "url": "=https://slack.com/api/conversations.history",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $credentials.httpHeaderAuth.value }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "channel", "value": "={{ $('Is MVP Sender?').item.json.channel }}" },
            { "name": "oldest", "value": "={{ $('Is MVP Sender?').item.json.timestamp }}" },
            { "name": "limit", "value": "20" }
          ]
        },
        "options": {}
      },
      "id": "check-channel-replies",
      "name": "Check Channel Messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 700],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SLACK_BOT_TOKEN_CREDENTIAL_ID",
          "name": "Slack Bot Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const threadReplies = $('Did You Reply?').item.json;\nconst channelMessages = $input.item.json;\nconst yourUserId = threadReplies.yourUserId;\nconst originalTs = threadReplies.timestamp;\n\n// If already found a threaded reply, pass through\nif (threadReplies.youReplied) {\n  return [{ json: { ...threadReplies, youReplied: true } }];\n}\n\n// Check channel-level messages (non-threaded replies)\nlet youRepliedInChannel = false;\nif (channelMessages.ok && channelMessages.messages) {\n  youRepliedInChannel = channelMessages.messages.some(msg => {\n    return msg.user === yourUserId && msg.ts > originalTs;\n  });\n}\n\nreturn [{\n  json: {\n    ...threadReplies,\n    youReplied: threadReplies.youReplied || youRepliedInChannel\n  }\n}];"
      },
      "id": "merge-reply-check",
      "name": "Merge Reply Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 700]
    }
  ],
  "connections": {
    "Slack Trigger": {
      "main": [
        [{ "node": "Skip Bot Messages", "type": "main", "index": 0 }]
      ]
    },
    "Skip Bot Messages": {
      "main": [
        [{ "node": "Extract Message", "type": "main", "index": 0 }],
        []
      ]
    },
    "Extract Message": {
      "main": [
        [
          { "node": "Claude Filter", "type": "main", "index": 0 },
          { "node": "Is MVP Sender?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Claude Filter": {
      "main": [
        [{ "node": "Parse Filter Result", "type": "main", "index": 0 }]
      ]
    },
    "Parse Filter Result": {
      "main": [
        [{ "node": "Is Relevant?", "type": "main", "index": 0 }]
      ]
    },
    "Is Relevant?": {
      "main": [
        [{ "node": "Send SMS via Twilio", "type": "main", "index": 0 }],
        []
      ]
    },
    "Is MVP Sender?": {
      "main": [
        [{ "node": "MVP?", "type": "main", "index": 0 }]
      ]
    },
    "MVP?": {
      "main": [
        [{ "node": "Wait 5 Minutes", "type": "main", "index": 0 }],
        []
      ]
    },
    "Wait 5 Minutes": {
      "main": [
        [
          { "node": "Check Thread Replies", "type": "main", "index": 0 },
          { "node": "Check Channel Messages", "type": "main", "index": 0 }
        ]
      ]
    },
    "Check Thread Replies": {
      "main": [
        [{ "node": "Did You Reply?", "type": "main", "index": 0 }]
      ]
    },
    "Did You Reply?": {
      "main": [
        [{ "node": "Merge Reply Check", "type": "main", "index": 0 }]
      ]
    },
    "Check Channel Messages": {
      "main": [
        [{ "node": "Merge Reply Check", "type": "main", "index": 0 }]
      ]
    },
    "Merge Reply Check": {
      "main": [
        [{ "node": "No Reply?", "type": "main", "index": 0 }]
      ]
    },
    "No Reply?": {
      "main": [
        [{ "node": "Get MVP Name", "type": "main", "index": 0 }],
        []
      ]
    },
    "Get MVP Name": {
      "main": [
        [{ "node": "Send MVP Alert SMS", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [{ "name": "LifeSync" }]
}
